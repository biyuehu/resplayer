{
  "name": "resplayer",
  "version": "1.1.5",
  "description": "A minimal, declarative music player written in ReScript — with lyrics scrolling, playlist, and theming support.",
  "type": "module",
  "license": "GPL-3.0-only",
  "keywords": [
    "music-player",
    "audio-player",
    "rescript",
    "lyrics",
    "player"
  ],
  "main": "src/RPlayer.res.js",
  "types": "src/RPlayer.res.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "res:build": "rescript",
    "res:clean": "rescript clean",
    "res:dev": "npx nodemon --watch src --ext res --exec \"npm run res:build\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@rescript/runtime": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "rescript": "^12.0.0",
    "vite": "^8.2.2"
  }
}